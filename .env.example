# ==============================================================================
# Xterminate V2 Automation & Validation Configuration
# ==============================================================================

# Application Base URL
BASE_URL=https://dev-xterminate-v2.businessthrust.com.sg

# Module Target URLs (Defaults derived automatically from BASE_URL if not provided)
LOGIN_URL=https://dev-xterminate-v2.businessthrust.com.sg/admin/login
EXPORT_HUB_URL=https://dev-xterminate-v2.businessthrust.com.sg/admin/export
VISIT_URL=https://dev-xterminate-v2.businessthrust.com.sg/admin/visit
CUSTOMER_URL=https://dev-xterminate-v2.businessthrust.com.sg/admin/customer
QUOTATION_URL=https://dev-xterminate-v2.businessthrust.com.sg/admin/quotation?status=all
INVOICE_URL=https://dev-xterminate-v2.businessthrust.com.sg/admin/invoice?status=all
PAYMENT_URL=https://dev-xterminate-v2.businessthrust.com.sg/admin/payment?status=all

# Admin Credentials (ADMIN_EMAIL or ADMIN_USERNAME are supported)
ADMIN_EMAIL=admin@genicteams.com
ADMIN_USERNAME=admin@genicteams.com
ADMIN_PASSWORD=your_password_here

# Playwright & Browser Config
HEADLESS=true
DEFAULT_TIMEOUT_MS=30000
EXPORT_WAIT_TIMEOUT_SEC=120

# LLM Providers (Optional for semantic discrepancy evaluations)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
LLM_MODEL_NAME=gemini-1.5-flash
