# Application Base URL
BASE_URL=https://stg-happie.businessthrust.com

# Target URLs
LOGIN_URL=https://stg-happie.businessthrust.com/admin/login
EXPORT_HUB_URL=https://stg-happie.businessthrust.com/admin/export
CUSTOMER_URL=https://stg-happie.businessthrust.com/admin/customer
QUOTATION_URL=https://stg-happie.businessthrust.com/admin/quotation?status=all
INVOICE_URL=https://stg-happie.businessthrust.com/admin/invoice?status=all
PAYMENT_URL=https://stg-happie.businessthrust.com/admin/payment?status=all

# Admin Credentials
ADMIN_EMAIL=your_email@example.com
ADMIN_PASSWORD=your_password

# Playwright & Browser Config
HEADLESS=true
DEFAULT_TIMEOUT_MS=30000
EXPORT_WAIT_TIMEOUT_SEC=120

# LLM Providers (Optional for semantic evaluations)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
LLM_MODEL_NAME=gemini-1.5-flash

