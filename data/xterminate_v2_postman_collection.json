    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "POST /api/v2/auth/login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v2/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v2",
                "auth",
                "login"
              ],
              "query": []
            },
            "description": "Authenticates user credentials and generates JWT bearer access token",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@genicteams.com\",\n  \"password\": \"string\",\n  \"client\": \"web\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json && json.data && json.data.token) {",
                  "        pm.collectionVariables.set(\"bearerToken\", json.data.token);",
                  "        console.log(\"Successfully stored bearerToken into collection variables.\");",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /api/v2/auth/verify",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
